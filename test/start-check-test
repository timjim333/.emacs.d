#!/usr/bin/env bash
# start-check-test: acceptance tests for bin/start-check.
#
# Each case runs bin/start-check on a throwaway clone of this checkout's
# committed HEAD, so commit before running.  Takes about 4 minutes
# (two GUI starts per case) and opens Emacs windows on the desktop.
# The clones are deleted when every case passes.
#
# Author: Tim Jim
# Date: 2026-10-31

set -u

repo=$(cd "$(dirname "$0")/.." && pwd)
check="$repo/bin/start-check"
work=$(mktemp -d /tmp/start-check-test.XXXXXX)
echo "Test clones: $work"
failures=0

# Clone HEAD into $work/<name> and print the clone's path.
clone() {
    git clone -q "$repo" "$work/$1"
    echo "$work/$1"
}

# Append an Emacs Lisp block to a clone's config.org and commit it, so
# the change isn't mistaken for a stray file.
add_block() {
    local dir=$1 form=$2
    printf '\n* Test\n#+begin_src emacs-lisp\n%s\n#+end_src\n' "$form" \
        >>"$dir/config.org"
    git -C "$dir" commit -q -am "test block"
}

# Run start-check with the given arguments; check the exit status
# (pass or fail) and that the output contains a fixed string.
expect() {
    local name=$1 want=$2 text=$3
    shift 3
    local output status got
    output=$("$check" "$@" 2>&1)
    status=$?
    got=pass
    [[ $status -ne 0 ]] && got=fail
    if [[ $got == "$want" ]] && grep -qF -- "$text" <<<"$output"; then
        echo "ok    $name"
    else
        echo "FAIL  $name: wanted $want with '$text', got $got (exit $status)"
        sed 's/^/      /' <<<"$output"
        failures=$((failures + 1))
    fi
}

dir=$(clone clean)
expect "clean checkout passes" pass "Report: /tmp/emacs-start-check." "$dir"

dir=$(clone warn)
add_block "$dir" '(warn "start-check test")'
expect "a warning fails" fail "start-check test" "$dir"

dir=$(clone error)
add_block "$dir" '(error "start-check error")'
expect "an init error fails" fail "init-file-had-error: t" "$dir"

dir=$(clone stray)
touch "$dir/stray"
expect "a stray file fails" fail "!! stray" "$dir"

expect "a missing checkout fails" fail "not a git checkout" "$work/missing"

dir=$(mktemp -d "$work/not-git.XXXXXX")
expect "a folder outside git fails" fail "not a git checkout" "$dir"

# Both cases below run /bin/false as Emacs, so they take seconds: it
# exits at once and writes no report, as a crash or a timeout would.
dir=$(clone no-report)
EMACS=/bin/false expect "no report fails" fail "no report written" "$dir"

dir=$(clone dot-emacs)
home=$(mktemp -d "$work/home.XXXXXX")
mkdir "$home/.emacs.d"
HOME=$home EMACS=/bin/false expect "an existing ~/.emacs.d fails" fail \
    "~/.emacs.d exists" "$dir"

# A fake Emacs that writes $FAKE_REPORT as its report, with @CHECKOUT@
# replaced by its --init-directory, so the judging can be tested
# without a GUI start.
fake_emacs="$work/fake-emacs"
printf '%s\n' '#!/usr/bin/env bash' \
    'while [[ $# -gt 0 && $1 != --init-directory ]]; do shift; done' \
    'sed "s|@CHECKOUT@|$2|" "$FAKE_REPORT" >"$START_CHECK_REPORT"' \
    >"$fake_emacs"
chmod +x "$fake_emacs"

# Write a fake report with the given header lines and a *Messages*
# section that holds lines a whole-file grep would mistake for them.
fake_report() {
    local file
    file=$(mktemp "$work/report.XXXXXX")
    printf '%s\n' "$@" "" "--- *Warnings* ---" "x" "" "--- *Messages* ---" \
        "init-file-had-error: nil" "warnings-buffer: none" >"$file"
    echo "$file"
}

dir=$(clone fake)
report=$(fake_report "init-file-had-error: t" "warnings-buffer: none" \
    "user-emacs-directory-truename: @CHECKOUT@/")
FAKE_REPORT=$report EMACS=$fake_emacs expect \
    "an init error fails despite *Messages*" fail "init-file-had-error: t" "$dir"
report=$(fake_report "init-file-had-error: nil" "warnings-buffer: 1 lines" \
    "user-emacs-directory-truename: @CHECKOUT@/")
FAKE_REPORT=$report EMACS=$fake_emacs expect \
    "warnings fail despite *Messages*" fail "*Warnings* is not empty" "$dir"
report=$(fake_report "init-file-had-error: nil" "warnings-buffer: none" \
    "user-emacs-directory-truename: /elsewhere/")
FAKE_REPORT=$report EMACS=$fake_emacs expect \
    "a report from another config fails" fail "another config" "$dir"

home=$(mktemp -d "$work/home.XXXXXX")
HOME=$home expect "--daemon without ~/.config/emacs fails" fail \
    "not a git checkout" --daemon

dir=$(clone other-config)
home=$(mktemp -d "$work/home.XXXXXX")
mkdir "$home/.config"
ln -s "$dir" "$home/.config/emacs"
HOME=$home expect "--daemon on another config fails" fail \
    "another config" --daemon

hang="$work/hanging-emacsclient"
printf '%s\n' '#!/usr/bin/env bash' 'sleep 60' >"$hang"
chmod +x "$hang"
EMACSCLIENT=$hang expect "a hanging daemon times out" fail "timed out" --daemon

expect "daemon reports its directory" pass \
    "user-emacs-directory: ~/.config/emacs/" --daemon
expect "daemon reports 31.1" pass "emacs-version: 31.1" --daemon

echo "$failures failure(s)"
if [[ $failures -eq 0 ]]; then
    rm -rf "$work"
else
    echo "Clones kept for inspection: $work"
    exit 1
fi
