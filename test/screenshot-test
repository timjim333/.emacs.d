#!/usr/bin/env bash
# screenshot-test: acceptance tests for bin/screenshot.
#
# Runs bin/screenshot on this checkout with small throwaway scripts.
# Takes about 3 minutes (eight GUI starts of about 20 s) and opens
# Emacs windows on the desktop.  The scripts' folder is deleted when
# every case passes.
#
# Author: Tim Jim
# Date: 2026-10-31

set -u

repo=$(cd "$(dirname "$0")/.." && pwd)
shoot="$repo/bin/screenshot"
work=$(mktemp -d /tmp/screenshot-test.XXXXXX)
echo "Test scripts: $work"
failures=0

pass() { echo "ok    $1"; }
fail() {
    echo "FAIL  $1"
    [[ -n ${2:-} ]] && sed 's/^/      /' <<<"$2"
    failures=$((failures + 1))
}

# Write a shot script to $work/$1.el, from the remaining lines.
script() {
    local name=$1
    shift
    printf '%s\n' ";;; -*- lexical-binding: t -*-" "$@" >"$work/$name.el"
    echo "$work/$name.el"
}

# Print the folder named on bin/screenshot's "Shots:" line.
shots_dir() { sed -n 's/^Shots: //p' <<<"$1"; }

ok=$(script ok \
    '(tim/screenshot-add "dark" (switch-to-buffer "*scratch*"))' \
    '(tim/screenshot-add "light" (load-theme (quote doom-nord-light) t))')
output=$("$shoot" "$repo" "$ok" 2>&1)
status=$?
dir=$(shots_dir "$output")
if [[ $status -eq 0 && -f $dir/dark.png && -f $dir/light.png ]]; then
    pass "two shots give two PNGs"
else
    fail "two shots give two PNGs (exit $status)" "$output"
fi
size=$(magick identify -format '%wx%h' "$dir/dark.png" 2>&1)
if [[ $size == 1600x900 ]]; then
    pass "shots are 1600x900"
else
    fail "shots are 1600x900, got $size"
fi

bad=$(script bad '(tim/screenshot-add "boom" (error "shot went wrong"))')
start=$SECONDS
output=$("$shoot" "$repo" "$bad" 2>&1)
status=$?
if [[ $status -ne 0 ]] && grep -qF "shot went wrong" <<<"$output" &&
    ((SECONDS - start < 60)); then
    pass "a failing shot exits early with its error"
else
    fail "a failing shot exits early with its error (exit $status, \
$((SECONDS - start)) s)" "$output"
fi

guard=$(script guard '(tim/screenshot-add "x" (tim/screenshot-install (quote beacon)))')
output=$(env -u SCREENSHOT_ELPA "$shoot" "$repo" "$guard" 2>&1)
status=$?
if [[ $status -ne 0 ]] && grep -qF "SCREENSHOT_ELPA" <<<"$output"; then
    pass "installing without SCREENSHOT_ELPA refuses"
else
    fail "installing without SCREENSHOT_ELPA refuses (exit $status)" "$output"
fi

output=$("$shoot" "$repo" 2>&1)
status=$?
if [[ $status -ne 0 ]] && grep -qF "Usage" <<<"$output"; then
    pass "a missing script argument fails"
else
    fail "a missing script argument fails (exit $status)" "$output"
fi

# Run a command, after any VAR=value environment settings; check that
# it fails within 60 s and that the output contains a fixed string.
expect_fail() {
    local name=$1 text=$2
    shift 2
    local output status start=$SECONDS
    output=$(env "$@" 2>&1)
    status=$?
    if [[ $status -ne 0 ]] && grep -qF -- "$text" <<<"$output" &&
        ((SECONDS - start < 60)); then
        pass "$name"
    else
        fail "$name (exit $status, $((SECONDS - start)) s)" "$output"
    fi
}

late=$(script late '(tim/screenshot-add "one" nil)' \
    '(error "script went wrong")')
expect_fail "a script error after a shot fails with its error" \
    "script went wrong" "$shoot" "$repo" "$late"

expect_fail "a folder that isn't a checkout fails" "not a git checkout" \
    "$shoot" "$work" "$ok"

broken="$work/broken-config"
git clone -q "$repo" "$broken"
printf '\n* Test\n#+begin_src emacs-lisp\n(error "config went wrong")\n#+end_src\n' \
    >>"$broken/config.org"
expect_fail "a config with an init error fails" "init error" \
    "$shoot" "$broken" "$ok"

big=$(script big '(tim/screenshot-add "big"' \
    '  (select-frame-set-input-focus' \
    '   (make-frame (quote ((width . 250) (height . 60))))))')
expect_fail "a shot larger than 1600x900 fails" "want 1600x900" \
    "$shoot" "$repo" "$big"

# A magick that fails only when padding, so the size check still runs.
mkdir "$work/bin"
printf '%s\n' '#!/usr/bin/env bash' \
    '[[ " $* " == *" -extent "* ]] && exit 1' \
    "exec $(command -v magick) \"\$@\"" >"$work/bin/magick"
chmod +x "$work/bin/magick"
expect_fail "a failed padding fails" "couldn't pad" \
    PATH="$work/bin:$PATH" "$shoot" "$repo" "$ok"

hidden=$(script hidden '(tim/screenshot-add ".hidden" nil)')
expect_fail "a run that leaves no PNGs fails" "no PNGs" \
    "$shoot" "$repo" "$hidden"

echo "$failures failure(s)"
if [[ $failures -eq 0 ]]; then
    rm -rf "$work"
else
    echo "Scripts kept for inspection: $work"
    exit 1
fi
